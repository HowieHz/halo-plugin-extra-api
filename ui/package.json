{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "run-p build:type-check \"build:build-only {@}\" --",
        "build:build-only": "vite build",
        "build:type-check": "vue-tsc --build",
        "dev": "pnpm run \"/^watch:.*/\"",
        "fmt": "pnpm run \"/^fmt:.*/\"",
        "fmt:oxfmt": "oxfmt --threads 2 \"**/*.{json,jsonc,yaml,md,css,js,ts,html,vue,less}\"",
        "lint": "run-s lint:*",
        "lint:eslint": "eslint . --fix",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "prepare": "cd .. && husky ui/.husky",
        "test": "pnpm run \"/^test:.*/\"",
        "test:unit": "vitest --passWithNoTests",
        "watch:vite": "vite build --watch --mode development"
    },
    "dependencies": {
        "@halo-dev/api-client": "^2.26.0",
        "@halo-dev/components": "^2.26.0",
        "@halo-dev/ui-shared": "^2.26.0",
        "axios": "^1.20.0",
        "canvas-confetti": "^1.9.4",
        "husky": "^9.1.7",
        "vue": "^3.5.42",
        "vue-router": "~5.3.1"
    },
    "devDependencies": {
        "@halo-dev/ui-plugin-bundler-kit": "^2.26.0",
        "@iconify-json/ri": "^1.2.10",
        "@vitejs/plugin-vue": "^6.0.8",
        "@tsconfig/node24": "^24.0.5",
        "@types/canvas-confetti": "^1.9.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.4.1",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.9.1",
        "eslint-plugin-oxlint": "^1.81.0",
        "eslint-plugin-vue": "~10.10.0",
        "husky": "^8.0.3",
        "jsdom": "^30.0.1",
        "npm-run-all2": "^9.0.3",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "sass": "^1.103.1",
        "typescript": "~6.0.3",
        "unplugin-icons": "^23.0.1",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": ">=24",
        "pnpm": "^11.25.0"
    },
    "packageManager": "pnpm@11.25.0"
}
